# =================================
# Financial Portfolio Application
# Environment Configuration
# =================================

# ============
# Database
# ============
DATABASE_URL="postgresql://postgres:password@localhost:5432/financial_portfolio?schema=public"
TIMESCALE_DB_URL="postgresql://postgres:password@localhost:5433/timeseries_data?schema=public"

# ============
# Redis
# ============
REDIS_URL="redis://localhost:6379"

# ============
# API Server
# ============
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ============
# Authentication
# ============
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ============
# Supabase (Optional)
# ============
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============
# OCR Services
# ============
GOOGLE_VISION_API_KEY=your_google_vision_api_key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============
# Rate Limiting
# ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============
# File Upload
# ============
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# ============
# Logging
# ============
LOG_LEVEL=info

# ============
# Next.js Frontend
# ============
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
